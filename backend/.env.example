# Copy to backend/.env and fill in. NEVER commit backend/.env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

# Comma-separated allowed browser origins (dashboard dev server)
CORS_ORIGINS=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=translivo

# Secrets — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ADMIN_SECRET=
JWT_DEVICE_SECRET=
# 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# NOTE: The Gemini API key is NOT configured here. It is set from the
# Admin Dashboard and stored AES-256-GCM encrypted in MySQL.
